# 复制为 .env 后修改
DB_PASSWORD=nuon_change_me
SECRET_KEY=请替换为至少32位的随机字符串
# 正式上线请设为 0（不生成演示业务数据）
SEED_DEMO=1
HTTP_PORT=8080

# 金蝶云星空账号登录（见 docs/kingdee-sso.md）
KINGDEE_ENABLED=0
KINGDEE_URL=http://金蝶服务器地址/k3cloud/
KINGDEE_ACCT_ID=数据中心ID
KINGDEE_AUTO_CREATE=1
KINGDEE_DEFAULT_ROLES=

# 安全与合规（见 docs/operations.md）
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_LETTER_DIGIT=1
PASSWORD_MAX_AGE_DAYS=90
IDLE_TIMEOUT_MINUTES=30
AUDIT_SEAL_INTERVAL_SECONDS=60
REQUIRE_QUALIFICATION=1
# 财务：本位币（汇率在“基础资料 → 汇率”维护）
BASE_CURRENCY=CNY
# 附件
ATTACHMENT_MAX_MB=20
# 自动备份（docker-compose backup 服务）
BACKUP_AT=02:30
BACKUP_KEEP_DAYS=30
