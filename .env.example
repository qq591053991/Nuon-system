# 复制为 .env 后修改
DB_PASSWORD=nuon_change_me
SECRET_KEY=请替换为至少32位的随机字符串
# 正式上线请设为 0：只创建系统管理员 admin（首次登录须改密），不生成演示账号和演示数据
SEED_DEMO=1
# 正式环境 admin 的初始密码（不设置则随机生成，并在后端首次启动日志中打印一次）
INITIAL_ADMIN_PASSWORD=
# 登录页是否显示“演示账号”下拉：1 显示 / 0 不显示 / 留空自动判断（仍有演示账号使用公开演示密码时显示）
DEMO_MODE=
# 演示账号首次登录是否也须修改密码（1 = 是）
DEMO_FORCE_PASSWORD_CHANGE=0
HTTP_PORT=8080

# 金蝶云星空账号登录（见 docs/kingdee-sso.md）
KINGDEE_ENABLED=0
KINGDEE_URL=http://金蝶服务器地址/k3cloud/
KINGDEE_ACCT_ID=数据中心ID
KINGDEE_AUTO_CREATE=1
KINGDEE_DEFAULT_ROLES=

# 安全与合规（见 docs/operations.md）
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_LETTER_DIGIT=1
PASSWORD_MAX_AGE_DAYS=90
IDLE_TIMEOUT_MINUTES=30
AUDIT_SEAL_INTERVAL_SECONDS=60
REQUIRE_QUALIFICATION=1
# 本公司信息（形式发票、采购订单、发货单打印抬头）
COMPANY_NAME=
COMPANY_NAME_EN=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_TAX_NO=
COMPANY_BANK=
# 采购单金额达到此值（本位币）时提醒厂长审批
PO_APPROVAL_THRESHOLD=50000
# 财务：本位币（汇率在“基础资料 → 汇率”维护）
BASE_CURRENCY=CNY
# 附件
ATTACHMENT_MAX_MB=20
# 自动备份（docker-compose backup 服务）
BACKUP_AT=02:30
BACKUP_KEEP_DAYS=30
